rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validUserRecord() {
        let d = request.resource.data;
        return d.keys().hasAll([
            'uid',
            'firstName',
            'lastName',
            'role',
            'registrationDateTime'
          ])
          && d.keys().hasOnly([
            'uid',
            'firstName',
            'lastName',
            'role',
            'registrationDateTime'
          ])
          && d.uid == uid
          && d.firstName is string
          && d.firstName.size() >= 1
          && d.firstName.size() <= 80
          && d.firstName.matches('.*[^\\s].*')
          && d.lastName is string
          && d.lastName.size() >= 1
          && d.lastName.size() <= 80
          && d.lastName.matches('.*[^\\s].*')
          && d.role == 'member'
          && d.registrationDateTime is timestamp
          && d.registrationDateTime == request.time;
      }

      allow get: if owner();
      allow create: if owner() && validUserRecord();
      allow list, update, delete: if false;
    }
  }
}